{% extends "_components/layouts/main.twig" %}

{% block title %}Список вопросов{% endblock %}

{% block content %}
<div class="mvh-100 d-flex flex-column align-items-center justify-content-center user-select-none">

    <div class="container">

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-sm-10">
                <h1 class="fw-bold text-center">{{test.name}}</h1>
                <div class="py-1 px-3 rounded">
                    <div class="row">
                        <div class="col-7">
                            Вопрос
                        </div>
                        <div class="col-5 text-end">
                            Действия
                        </div>
                    </div>
                </div>
                {% for v in questions %}
                <div class="elevation--z4 my-1 py-1 px-3 rounded text-light">
                    <div class="row">
                        <div class="col-7">
                            {{v.text}}
                        </div>
                        <div class="col-5 text-end">
                            <a href="{{config['base_link']}}/admin/question/{{v.id}}" class="mx-1">редактировать</a>
                            <form method="post" action="{{config['base_link']}}/api/admin/question/{{v.id}}/delete" class="d-inline">
                                <button type="submit" class="btn btn-link link-inline p-0 mx-1 align-baseline">удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
                {% endfor %}
                <div class="py-1 px-3 rounded">
                    <div class="row">
                        <div class="col-7">
                        </div>
                        <div class="col-5 text-end">
                            <a href="{{config['base_link']}}/admin/test/{{test.id}}/questions/create"
                                class="mx-1">новый</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
{% endblock %}